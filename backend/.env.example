# Puerto en el que escucha la API
PORT=4000

# Entorno: development | production
NODE_ENV=development

# Orígenes autorizados a llamar a la API, separados por coma.
# En desarrollo es el servidor de Vite.
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL -------------------------------------------------------
# Dos formas de configurarlo; si hay DATABASE_URL, manda esa.
#
# 1) Una URL completa. Es lo que dan Render, Railway, Neon y similares:
# DATABASE_URL=postgres://usuario:clave@servidor:5432/pedidos_tienda
#
# 2) O las variables sueltas, que es lo cómodo en local:
PGHOST=localhost
PGPORT=5432
PGDATABASE=pedidos_tienda
PGUSER=postgres
PGPASSWORD=

# Poner en "true" si el servidor de base de datos exige TLS (los gestionados
# casi siempre lo exigen; un Postgres local, casi nunca).
PGSSL=false

# Ajustes del pool de conexiones. Se pueden dejar como están.
# PGPOOL_MAX=10
# PGPOOL_IDLE_MS=30000
# PGPOOL_CONNECT_MS=10000

# Carpeta con el build del frontend que la API sirve en producción.
# Si no existe, la API funciona solo como servicio JSON.
STATIC_DIR=../frontend/dist
